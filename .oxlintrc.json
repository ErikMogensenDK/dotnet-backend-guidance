{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-unused-vars": ["error", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrorsIgnorePattern": "^.*$"
    }],
    "no-undef": "error"
  },
  "ignorePatterns": ["modern-web-guidance-src/**", "dist/**"]
}
