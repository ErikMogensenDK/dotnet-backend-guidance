{
  "name": "dotnet-backend-guidance",
  "version": "0.1.0",
  "description": "Locally searchable best-practice guidance for C#/.NET backend development, for developers and coding agents.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErikMogensenDK/ModernBackendGuidance.git"
  },
  "bin": {
    "dotnet-backend-guidance": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "node src/build/build.ts",
    "bench": "node src/build/bench.ts",
    "test": "node --test --test-reporter=dot \"src/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "oxlint",
    "preflight": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "marked": "^18.2.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
}
